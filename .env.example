# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Anthropic (needed from Phase 4 onward) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Google OAuth ---
# Path to the OAuth client file downloaded from Google Cloud Console.
GOOGLE_CREDENTIALS_FILE=credentials.json
# Must exactly match an Authorised redirect URI on the OAuth client.
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback

# --- App ---
APP_BASE_URL=http://localhost:8000
# Signs the session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# --- Gmail scan window ---
# Spec 3.3: fixed start of application season, not a rolling window.
EMAIL_SINCE=2026-08-25

# Gate LLM calls on a keyword job-signal check before extraction.
# Mail from a known ATS always bypasses the gate. Set false for max recall
# at roughly 4x the per-rescan extraction cost.
USE_KEYWORD_PREFILTER=true

# --- Staleness thresholds (days) ---
STALE_DAYS_POST_INTERVIEW=7
STALE_DAYS_POST_APPLIED=28

# --- Sheet ---
SHEET_TITLE=Job Application Tracker
